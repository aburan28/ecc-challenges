FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml /app/
COPY src/ /app/src/
COPY infra/rds-ca.pem /app/rds-ca.pem
RUN pip install --no-cache-dir . && useradd --uid 10001 --create-home --shell /usr/sbin/nologin ecc
USER 10001:10001
EXPOSE 8080
CMD ["uvicorn", "ecc_challenges.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips", "*"]
