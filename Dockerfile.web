FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
WORKDIR /app
COPY requirements.lock /app/
COPY src/ /app/src/
COPY infra/rds-ca.pem /app/rds-ca.pem
RUN pip install --no-cache-dir --require-hashes -r requirements.lock \
  && useradd --uid 10001 --create-home --shell /usr/sbin/nologin ecc
USER 10001:10001
EXPOSE 8080
CMD ["uvicorn", "ecc_challenges.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips", "*"]
