# Copy to .env next to compose.yaml.
# Your user and group, so files stay yours: run `id -u` and `id -g`.
ECC_UID=1000
ECC_GID=1000
# Any curve from https://ecc-challenges.com/v1/campaigns
ECC_CAMPAIGN=eccp-131
# One amd64 image runs every curve on CPU or NVIDIA CUDA. Replace this reviewed
# published digest with the dashboard's current digest when a new release lands.
ECC_WORKER_IMAGE=public.ecr.aws/o1a3z1g6/ecc-challenges-worker@sha256:c7b58f784a8d8ea62d1649062387e76558d627c166fef14f185b6dab417a6f2e
# CPU threads (empty = every core Docker gives the container)
ECC_CPU_THREADS=
