# Podman Quadlet unit: a rootless, systemd-managed worker.
#
#   podman secret create ecc-api-key ~/.config/ecc-challenges/api-key
#   mkdir -p ~/.config/containers/systemd
#   cp ecc-worker.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload && systemctl --user start ecc-worker
#   loginctl enable-linger "$USER"     # keep it running after logout
#
# For a GPU: use the GPU image, set ECC_BACKEND=cuda and uncomment AddDevice
# (needs the NVIDIA Container Toolkit's CDI spec: nvidia-ctk cdi generate).
[Unit]
Description=ECC Challenges worker

[Container]
Image=public.ecr.aws/o1a3z1g6/ecc-challenges-worker-cpu@sha256:3e64885e81d55cbe67552e664ca46a38cc5f7276e6041d211b03fc8d2b0a30d8
Environment=ECC_CAMPAIGN=eccp-131 ECC_BACKEND=cpu ECC_PROTOCOL=2
# Delivered as an environment secret: no file or mount point needed, and the
# worker removes it from its environment before starting the engine.
Secret=ecc-api-key,type=env,target=ECC_API_KEY
Volume=ecc-worker-data:/data
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
#AddDevice=nvidia.com/gpu=all

[Service]
Restart=on-failure
TimeoutStopSec=150

[Install]
WantedBy=default.target
