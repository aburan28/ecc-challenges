# Settings for one worker. Copy per instance: /etc/ecc-challenges/<name>.env
ECC_CAMPAIGN=eccp-131
# auto picks cuda when an NVIDIA GPU is visible, else cpu
ECC_BACKEND=auto
# GPU index for this instance (CUDA only)
ECC_GPU=0
# CPU threads for the CPU backend (default: all cores this unit may use)
#OMP_NUM_THREADS=8
# Docker unit only (ecc-worker-docker@.service):
#ECC_IMAGE=ghcr.io/aburan28/ecc-challenges-worker@sha256:...
#ECC_DOCKER_ARGS=--gpus all
